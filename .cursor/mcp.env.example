# Copie este arquivo para .cursor/mcp.env e preencha os valores reais.
# .cursor/mcp.env NUNCA deve ser commitado (ja esta no .gitignore).

# --- Obsidian MCP (obrigatorio para a skill session-management) ---
# 1. Abra docs/obsidian/ como vault no app Obsidian
# 2. Settings > Community plugins > desative o modo restrito > instale e ative "Local REST API"
# 3. Copie a API key em Settings > Local REST API
OBSIDIAN_API_KEY=
OBSIDIAN_HOST=127.0.0.1
OBSIDIAN_PORT=27124
