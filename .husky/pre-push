#!/usr/bin/env sh
. "$(dirname -- "$0")/_/husky.sh"

# Harness - pre-push gate (Feedback Sensors - Full validation)
#
# 1. Re-validates every commit message in the push range (catches commits that
#    entered via rebase/cherry-pick and skipped the commit-msg hook).
# 2. yarn lint:check - full ESLint pass (read-only, no --fix).
# 3. Unit test suite (no coverage gate - coverage e um check manual do DoD,
#    ver .cursor/rules/definition-of-done.mdc Gate 1).
#
# Integration tests (yarn test:integration) NAO rodam aqui: dependem do
# json-server local (yarn server) rodando, o que e fragil para um git hook
# automatico. Rode manualmente ou integre na CI.
#
# Nota: husky roda este arquivo com `sh -e`, entao todo comando que pode
# legitimamente retornar != 0 precisa de `|| true` ou estar dentro de um `if`.
#
# See: AGENTS.md (section 5), .cursor/rules/definition-of-done.mdc

REPO_ROOT=$(git rev-parse --show-toplevel)
cd "$REPO_ROOT" || exit 1

valid_types="feat|fix|refactor|test|docs|style|chore|perf"

echo ""
echo "Pre-push: validando mensagens de commit no range do push..."

upstream_branch=$(git rev-parse --abbrev-ref @{upstream} 2>/dev/null | sed 's@^origin/@@' || true)

if [ -n "$upstream_branch" ]; then
  merge_base=$(git merge-base HEAD "origin/$upstream_branch" 2>/dev/null || true)
else
  # New branch, no upstream yet: pick whichever integration branch (develop, main)
  # gives the SMALLEST commit range - that's the actual point this branch forked from.
  # (Blindly defaulting to origin/HEAD's default branch can pick a much older common
  # ancestor when develop and main have diverged, sweeping in unrelated legacy commits.)
  merge_base=""
  best_count=""
  for candidate in develop main; do
    if git rev-parse -q --verify "origin/$candidate" >/dev/null 2>&1; then
      candidate_base=$(git merge-base HEAD "origin/$candidate" 2>/dev/null || true)
      [ -z "$candidate_base" ] && continue
      candidate_count=$(git rev-list --count "$candidate_base..HEAD" 2>/dev/null || true)
      if [ -n "$candidate_count" ] && { [ -z "$best_count" ] || [ "$candidate_count" -lt "$best_count" ]; }; then
        best_count="$candidate_count"
        merge_base="$candidate_base"
      fi
    fi
  done
fi

if [ -z "$merge_base" ]; then
  echo "  Nao foi possivel determinar o range (branch nova/sem upstream), pulando validacao de commits."
else
  invalid=""
  for sha in $(git rev-list "$merge_base..HEAD" 2>/dev/null || true); do
    parent_count=$(git rev-list --parents -n 1 "$sha" 2>/dev/null | wc -w || true)
    if [ "$parent_count" -gt 2 ]; then
      continue
    fi

    msg=$(git log --format=%s -n 1 "$sha" 2>/dev/null || true)
    if ! echo "$msg" | grep -qE "^($valid_types)\([a-z0-9/_.-]+\): .+"; then
      invalid="$invalid\n  - $sha: $msg"
    fi
  done

  if [ -n "$invalid" ]; then
    echo ""
    echo "Push bloqueado: commits com formato invalido encontrados no range:"
    printf "$invalid\n"
    echo ""
    echo "Formato esperado: <type>(<module>/<file>): <description>"
    echo "Use 'git rebase -i' para corrigir as mensagens."
    echo ""
    exit 1
  fi

  echo "  Todos os commits no range estao validos"
fi

echo ""
echo "Pre-push: lint completo (yarn lint:check)..."
if ! yarn lint:check; then
  echo ""
  echo "Push bloqueado: 'yarn lint:check' encontrou problemas."
  exit 1
fi

echo ""
echo "Pre-push: suite de testes unitarios..."
if ! npx jest --passWithNoTests --no-cache --runInBand; then
  echo ""
  echo "Push bloqueado: testes unitarios falharam."
  exit 1
fi

echo ""
echo "Pre-push OK"
exit 0
