#!/usr/bin/env sh
. "$(dirname -- "$0")/_/husky.sh"

# Harness - commit-msg gate
#
# Validates Conventional Commits format defined in AGENTS.md (section "Commits"):
#   <type>(<module>/<file>): <description>
#
# See: AGENTS.md, .cursor/rules/pre-commit-hooks.mdc

commit_msg_file="$1"
commit_msg=$(cat "$commit_msg_file")

# Merge commits keep git's default multi-line message; don't fight that.
if git rev-parse -q --verify MERGE_HEAD >/dev/null 2>&1; then
  exit 0
fi

valid_types="feat|fix|refactor|test|docs|style|chore|perf"

# 1. Format: <type>(<module>/<file>): <description>
if ! echo "$commit_msg" | grep -qE "^($valid_types)\([a-z0-9/_.-]+\): .+"; then
  echo ""
  echo "Commit bloqueado: formato de mensagem invalido."
  echo ""
  echo "Formato esperado (Conventional Commits): <type>(<module>/<file>): <description>"
  echo "Tipos validos: feat, fix, refactor, test, docs, style, chore, perf"
  echo ""
  echo "Exemplos validos:"
  echo "  feat(main/placelistfactory): pass listPlaces and navigate by param to usePlaceList"
  echo "  fix(checkout/paymentusecase): handle null card token before charging"
  echo "  test(shared/formatcurrency): add edge cases for negative values"
  echo ""
  echo "Exemplos invalidos:"
  echo "  feat: adiciona fallback           (sem escopo, e em portugues)"
  echo "  TASK-123: fix bug                 (formato antigo baseado em Azure DevOps)"
  echo ""
  echo "Sua mensagem: $commit_msg"
  echo ""
  exit 1
fi

# 2. No non-ASCII characters - descriptions must be in English (AGENTS.md rule #2)
if echo "$commit_msg" | LC_ALL=C grep -q '[^ -~]'; then
  echo ""
  echo "Commit bloqueado: mensagem contem caracteres nao-ASCII."
  echo "Escreva a descricao em ingles, sem acentos."
  echo ""
  echo "Sua mensagem: $commit_msg"
  echo ""
  exit 1
fi

# 3. Single line only, no commit body (AGENTS.md rule #4)
# Exception: trailers like "Co-authored-by:" are authorship metadata, not a body
# (Cursor appends "Co-authored-by: Cursor <cursoragent@cursor.com>" automatically).
non_empty_lines=$(printf '%s\n' "$commit_msg" | grep -v '^#' | grep -vE '^(Co-authored-by|Signed-off-by):' | grep -c '[^[:space:]]')
if [ "$non_empty_lines" -gt 1 ]; then
  echo ""
  echo "Commit bloqueado: corpo de mensagem detectado."
  echo "Use apenas uma linha: git commit -m \"tipo(escopo): descricao\" (sem corpo)."
  echo ""
  exit 1
fi

exit 0
